						"navigationBarTitleText": "家人资料",
						"navigationBarBackgroundColor": "#FFF6EF",
						"navigationBarTextStyle": "black"
					}
				},
				{
					"path": "family-tree",
					"style": {
						"navigationBarTitleText": "家族图谱",
						"navigationBarBackgroundColor": "#FFF6EF",
						"navigationBarTextStyle": "black"
					}
				}
			]
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "忆伴",
		"navigationBarBackgroundColor": "#FFF6EF",
		"backgroundColor": "#FFF6EF",
		"backgroundTextStyle": "dark"
