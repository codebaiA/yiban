{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^yb-(.*)": "@/components/yb-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "忆伴",
				"navigationBarBackgroundColor": "#FFF6EF",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/memory/memoir",
			"style": {
				"navigationBarTitleText": "我的回忆",
				"navigationBarBackgroundColor": "#FFF6EF",
				"navigationBarTextStyle": "black"
			}
		},
		{
			"path": "pages/mine/mine",
			"style": {
				"navigationBarTitleText": "我的",
				"navigationBarBackgroundColor": "#FFF6EF",
				"navigationBarTextStyle": "black"
			}
		},
		{
			"path": "pages/training/clock",
			"style": {
				"navigationBarTitleText": "脑力训练",
				"navigationBarBackgroundColor": "#F5F9F6",
				"navigationBarTextStyle": "black",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/dev/showcase",
			"style": {
				"navigationBarTitleText": "组件样板页",
				"navigationBarBackgroundColor": "#FFF6EF",
				"navigationBarTextStyle": "black"
			}
		}
